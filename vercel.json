{
	"buildCommand": "pnpm run db:generate && pnpm run build",
	"outputDirectory": "dist",
	"framework": null,
	"rewrites": [
		{
			"source": "/api/:path*",
			"destination": "https://bharatzero-production.up.railway.app/api/:path*"
		},
		{
			"source": "/:path*",
			"destination": "/index.html"
		}
	]
}
