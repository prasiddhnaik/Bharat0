{
	"buildCommand": "pnpm run db:generate && pnpm run build",
	"outputDirectory": "dist",
	"framework": null,
	"regions": ["bom1"],
	"functions": { "api/ogd-catalogs.ts": { "maxDuration": 120 } },
	"rewrites": [
		{
			"source": "/api/ogd-catalogs",
			"destination": "/api/ogd-catalogs"
		},
		{
			"source": "/api/(.*)",
			"destination": "https://bharat0.onrender.com/api/$1"
		},
		{
			"source": "/:path*",
			"destination": "/index.html"
		}
	]
}
