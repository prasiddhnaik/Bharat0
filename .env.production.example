# Required: hosted Postgres connection string.
# For Neon, use the direct production connection string because deployment runs
# `prisma db push` before the app starts.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"

HOST="0.0.0.0"
PORT="8080"
NODE_ENV="production"

# AI bill analysis via Gemma 4 on the Gemini API.
# GEMINI_API_KEY is also accepted as a fallback alias.
GEMMA_API_KEY=""
GEMMA_MODEL="gemma-4-31b-it"
GEMMA_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
AI_ANALYSIS_PROVIDER="gemma"
