# Required: hosted Postgres connection string.
# For Neon, use the direct production connection string because deployment runs
# `prisma db push` before the app starts.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Render and most managed hosts set PORT automatically.
HOST="0.0.0.0"
PORT="8080"
NODE_ENV="production"

# Server-only AI analysis. Leave unset to disable provider-backed analysis until keys exist.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"
AI_ANALYSIS_PROVIDER="groq"
