generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum House {
  LOK_SABHA
  RAJYA_SABHA
  JOINT_SITTING
  STATE_ASSEMBLY
  STATE_COUNCIL
}

enum BillType {
  ORDINARY
  MONEY
  FINANCIAL
  CONSTITUTIONAL_AMENDMENT
}

enum BillStage {
  DRAFT
  INTRODUCED
  LISTED
  TAKEN_UP
  REFERRED_COMMITTEE
  COMMITTEE_REPORTED
  PASSED_ORIGIN_HOUSE
  TRANSMITTED_TO_OTHER_HOUSE
  PASSED_SECOND_HOUSE
  RETURNED_WITH_AMENDMENTS
  JOINT_SITTING_POSSIBLE
  JOINT_SITTING_PASSED
  PRESIDENT_ASSENT_PENDING
  ASSENTED
  ACT_PUBLISHED
  WITHDRAWN
  LAPSED
  INTRODUCED_LOK_SABHA
  PASSED_LOK_SABHA
  SENT_TO_RAJYA_SABHA
  RAJYA_SABHA_RECOMMENDATION_PERIOD
  RETURNED_WITH_RECOMMENDATIONS
  DEEMED_PASSED_AFTER_14_DAYS
}

enum SittingStatus {
  SCHEDULED
  SAT
  ADJOURNED
  HOLIDAY
  DEMO
}

enum CommitteeType {
  STANDING
  SELECT
  JOINT
  DEPARTMENT_RELATED
}

enum AnswerStatus {
  LISTED
  ANSWERED
  DEFERRED
}

enum TimelineEventType {
  SITTING_SCHEDULED
  AGENDA_PUBLISHED
  BILL_INTRODUCED
  BILL_LISTED
  BILL_TAKEN_UP
  BILL_REFERRED_COMMITTEE
  COMMITTEE_REPORT_TABLED
  QUESTION_LISTED
  QUESTION_ANSWERED
  DEBATE_PUBLISHED
  BILL_PASSED_ORIGIN_HOUSE
  BILL_TRANSMITTED
  BILL_PASSED_SECOND_HOUSE
  BILL_ASSENTED
  ACT_PUBLISHED
  BILL_WITHDRAWN
  BILL_LAPSED
}

enum DebateTranscriptStatus {
  METADATA_ONLY
  EXTRACTED
  FAILED
  STALE
}

model Bill {
  id                 String          @id
  title_en           String
  title_hi           String
  bill_number        String
  bill_year          Int
  bill_type          BillType
  origin_house       House
  current_stage      BillStage
  ministry           String
  introduced_on      DateTime
  latest_action_date DateTime
  source_url         String
  summary            String
  is_demo_seed       Boolean         @default(true)
  actions            BillAction[]
  timeline_events    TimelineEvent[]
  acts               Act[]
  ai_analyses        AiBillAnalysis[]
  source_texts       BillSourceText[]
  debates            Debate[]
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt

  @@index([bill_year, bill_type])
  @@index([origin_house, current_stage])
}

model BillAction {
  id            String   @id
  bill_id       String
  bill          Bill     @relation(fields: [bill_id], references: [id], onDelete: Cascade)
  date          DateTime
  house         House
  action_type   String
  description   String
  source_url    String
  is_demo_seed  Boolean  @default(true)
  created_at    DateTime @default(now())

  @@index([bill_id, date])
  @@index([house, date])
}

model SittingDay {
  id           String        @id
  date         DateTime
  house        House
  session_name String
  status       SittingStatus
  is_demo_seed Boolean       @default(true)
  created_at   DateTime      @default(now())

  @@unique([date, house])
  @@index([session_name])
}

model TimelineEvent {
  id              String            @id
  date            DateTime
  house           House
  type            TimelineEventType
  title           String
  description     String
  related_bill_id String?
  related_bill    Bill?             @relation(fields: [related_bill_id], references: [id], onDelete: SetNull)
  source_url      String
  is_demo_seed    Boolean           @default(true)
  created_at      DateTime          @default(now())

  @@index([date, house])
  @@index([type])
  @@index([related_bill_id])
}

model Committee {
  id           String        @id
  name         String
  house        House
  type         CommitteeType
  source_url   String
  is_demo_seed Boolean       @default(true)
  created_at   DateTime      @default(now())

  @@index([house, type])
}

model Question {
  id            String       @id
  number        String
  house         House
  date          DateTime
  ministry      String
  subject       String
  answer_status AnswerStatus
  source_url    String
  is_demo_seed  Boolean      @default(true)
  created_at    DateTime     @default(now())

  @@index([house, date])
  @@index([ministry])
}

model Debate {
  id                     String            @id
  house                  House
  date                   DateTime
  title                  String
  summary                String
  source_url             String
  transcript_url         String?
  transcript_pages       Int?
  transcript_byte_length Int?
  transcript_language    String?
  members                String[]
  lok_sabha_number       String?
  session_number         String?
  debate_type            String?
  related_bill_id        String?
  related_bill           Bill?             @relation(fields: [related_bill_id], references: [id], onDelete: SetNull)
  is_demo_seed           Boolean           @default(true)
  transcript             DebateTranscript?
  ai_summaries           AiDebateAnalysis[]
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt

  @@index([house, date])
  @@index([source_url])
  @@index([related_bill_id])
  @@index([debate_type])
}

model DebateTranscript {
  id                 String                 @id @default(cuid())
  debate_id          String                 @unique
  debate             Debate                 @relation(fields: [debate_id], references: [id], onDelete: Cascade)
  source_url         String
  resolved_url       String?
  content_type       String?
  byte_length        Int?
  char_count         Int                    @default(0)
  text_hash          String?
  text               String                 @default("")
  status             DebateTranscriptStatus @default(METADATA_ONLY)
  error              String?
  extracted_at       DateTime               @default(now())
  extracted_from_url String?
  updated_at         DateTime               @updatedAt

  @@index([source_url])
  @@index([resolved_url])
  @@index([text_hash])
  @@index([status])
}

model Act {
  id             String   @id
  title          String
  act_number     String
  year           Int
  linked_bill_id String
  linked_bill    Bill     @relation(fields: [linked_bill_id], references: [id], onDelete: Restrict)
  india_code_url String
  is_demo_seed   Boolean  @default(true)
  created_at     DateTime @default(now())

  @@index([year])
  @@index([linked_bill_id])
}

model AiBillAnalysis {
  id           String   @id @default(cuid())
  bill_id      String
  bill         Bill     @relation(fields: [bill_id], references: [id], onDelete: Cascade)
  language     String
  provider     String   @default("gemma")
  model        String
  input_hash   String
  analysis     Json
  generated_at DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([bill_id, language, provider, model, input_hash])
  @@index([bill_id, language, provider])
}

model AiDebateAnalysis {
  id           String   @id @default(cuid())
  debate_id    String
  debate       Debate   @relation(fields: [debate_id], references: [id], onDelete: Cascade)
  language     String
  provider     String   @default("gemma")
  model        String
  input_hash   String
  analysis     Json
  generated_at DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([debate_id, language, provider, model, input_hash])
  @@index([debate_id, language, provider])
}

model BillSourceText {
  id           String   @id @default(cuid())
  bill_id      String
  bill         Bill     @relation(fields: [bill_id], references: [id], onDelete: Cascade)
  source_url   String
  resolved_url String?
  content_type String?
  byte_length  Int?
  char_count   Int      @default(0)
  text_hash    String?
  text         String   @default("")
  status       String   @default("extracted")
  error        String?
  extracted_at DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([source_url])
  @@index([bill_id])
  @@index([text_hash])
  @@index([status])
}

model PrimeMinisterProfile {
  id           String   @id @default(cuid())
  term_ids     String[]
  summary      String
  highlights   Json
  source_label String
  source_url   String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([source_url])
  @@index([term_ids])
}

model LokSabhaPowerSnapshot {
  id                      String   @id @default(cuid())
  prime_minister_term_ids String[]
  lok_sabha               String
  period                  String
  election_year           Int
  largest_party           String
  largest_party_seats     Int
  runner_up_party         String
  runner_up_seats         Int
  governing_side          String
  governing_seats         Int?
  majority_mark           Int
  power_summary           String
  composition             Json
  source_label            String
  source_url              String
  as_of                   String
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  @@unique([lok_sabha, election_year, period])
  @@index([prime_minister_term_ids])
}
