# BharatZero database target.
# Local Docker default:
DATABASE_URL="postgresql://bharatzero:bharatzero@localhost:5432/bharatzero?schema=public"
# Production should use the hosted Neon/Render/Railway Postgres connection string.
# Example shape:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"

HOST="127.0.0.1"
PORT="5173"

# Server-only AI analysis. Keep real keys in .env.local.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"

# groq or nvidia. The other configured provider is used as fallback.
AI_ANALYSIS_PROVIDER="groq"
